CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Filled in by create-wallet.ts output
WALLET_ID=
WALLET_ADDRESS=

# Filled in by deploy-registry.ts / deploy-payment-token.ts output
REGISTRY_CONTRACT_ID=
REGISTRY_CONTRACT_ADDRESS=
PAYMENT_TOKEN_CONTRACT_ID=
PAYMENT_TOKEN_CONTRACT_ADDRESS=

# Filled in by deploy-royalty.ts output
ROYALTY_CONTRACT_ID=
ROYALTY_CONTRACT_ADDRESS=

# The payout authority is the wallet address of a User row promoted to
# role='admin' in Postgres (see AudioBlock_Backend) — not a Circle-created
# wallet. See circle-deploy/README.md for why.
POOL_PAYOUT_AUTHORITY_ADDRESS=

# Filled in by deploy-pool.ts output
POOL_CONTRACT_ID=
POOL_CONTRACT_ADDRESS=

# Set this to whichever transaction/contract id you want to check
TRANSACTION_ID=
CONTRACT_ID=
