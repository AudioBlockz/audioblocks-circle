# Server Configuration
PORT=4000
NODE_ENV=development
# This API's own public base URL — an adaptive-bitrate song's master
# playlist points its per-rendition variants back here (see
# src/workers/precomputeManifest.ts). Defaults to http://localhost:$PORT if
# unset, which is fine for local dev; set this to the real deployed URL
# (e.g. https://your-app.up.railway.app) in production.
PUBLIC_API_URL=

# Database Configuration
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_USERNAME=

PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Privy (authentication + server-side signing for on-chain writes) — from the
# Privy dashboard, must match the frontend's NEXT_PUBLIC_PRIVY_APP_ID
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Only required if this Privy app has a wallet authorization keypair enabled
# in the dashboard (Wallet Infrastructure > Authorization keys). Leave blank
# if you haven't set one up — sendArcContractTransaction will fail with an
# auth-signature error if this is required but missing.
PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY=

# Arc Testnet RPC — defaults to https://rpc.testnet.arc.io if unset
ARC_RPC_URL=

# Must hold USDC (Arc's own gas token) — signs fiat-funded pool deposits,
# fiat room-ticket purchases, and (see ArtistService.fundGasStipend) the
# small USDC transfer that gives a brand-new artist wallet enough gas to
# pay for its own first on-chain transaction.
TREASURY_WALLET_ADDRESS=
# Amount of USDC (human units, e.g. "0.5") sent to a new artist wallet so
# it can pay for its own setupArtistAccountOnChain call. Defaults to 0.5.
ARTIST_SETUP_GAS_STIPEND=

# AWS S3 (song audio, HLS segments, cover images) — see setup steps below.
# The bucket must block public access: streaming is served through signed
# URLs (src/workers/precomputeManifest.ts), not public object ACLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# RabbitMQ (song-processing queue: transcode, cover art, on-chain registration)
# RABBITMQ_USER/RABBITMQ_PASS only bootstrap the container's admin account if
# you run RabbitMQ via docker-compose — unrelated to RABBITMQ_URL below.
RABBITMQ_USER=
RABBITMQ_PASS=
# Full connection string the app actually connects with, e.g.
# amqp://<user>:<pass>@<host>:5672/ — for local dev, install RabbitMQ
# directly and point this at localhost instead of using docker-compose.
RABBITMQ_URL=

PRIVATE_KEY=
PRIVATE_KEY_2=

TWITTER_APP_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_AUTH_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Replicate (AI music generation)
REPLICATE_API_TOKEN=
REPLICATE_MUSICGEN_VERSION=671ac645ce5e552cc63a54a2bbff63fcf798043055d2dac5fc9e36a837eedcc
AI_GENERATION_POLL_INTERVAL_MS=5000
AI_GENERATION_TIMEOUT_MS=300000
